# Configuración de Base de Datos PostgreSQL (Supabase / Neon / Local)
DATABASE_URL="postgresql://usuario:contrasena@servidor:5432/basedatos"

# Secretos y Sesiones JWT (generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
SESSION_SECRET="tu-clave-secreta-de-64-caracteres"

# URL de la Aplicación en Producción
NEXT_PUBLIC_APP_URL="https://tu-dominio.com"
