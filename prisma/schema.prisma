generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
  MOZO
  CAJERO
}

enum TipoTransaccion {
  CONSUMO
  ENCUESTA
  REFERIDO
  AJUSTE_MANUAL
  CANJE_PREMIO
}

enum EstadoCanje {
  PENDIENTE
  COMPLETADO
  EXPIRADO
  CANCELADO
}

enum FranjaHoraria {
  ALMUERZO
  CENA
  TARDE
  OTRO
}

model Socio {
  id               String               @id @default(uuid())
  numeroSocio      String               @unique
  dni              String               @unique
  nombre           String
  apellido         String?
  telefono         String?
  email            String?
  passwordHash     String?
  puntosActuales   Int                  @default(0)
  puntosHistoricos Int                  @default(0)
  activo           Boolean              @default(true)
  fechaAlta        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  visitas          VisitaConsumo[]
  transacciones    TransaccionPuntos[]
  canjes           CanjePremio[]
  respuestasEncuesta RespuestaEncuesta[]

  @@index([dni])
  @@index([numeroSocio])
  @@index([puntosHistoricos(sort: Desc)])
}

model Usuario {
  id           String          @id @default(uuid())
  username     String          @unique
  nombre       String
  role         RolUsuario      @default(MOZO)
  passwordHash String
  activo       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  visitasRegistradas VisitaConsumo[]
  transacciones      TransaccionPuntos[]
  canjesValidados    CanjePremio[]
}

model VisitaConsumo {
  id                      String                @id @default(uuid())
  socioId                 String
  socio                   Socio                 @relation(fields: [socioId], references: [id], onDelete: Cascade)
  registradoPorId         String?
  registradoPor           Usuario?              @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  fechaVisita             DateTime              @default(now())
  franjaHoraria           FranjaHoraria         @default(CENA)
  montoTotalTicket        Decimal               @db.Decimal(12, 2)
  cantidadComensales      Int                   @default(1)
  gastoPromedioPorPersona Decimal               @db.Decimal(12, 2)
  puntosAcreditados       Int                   @default(0)
  notas                   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  platos                  ItemPlatoConsumido[]
  ticketAdjunto           TicketAdjunto?
  respuestaEncuesta       RespuestaEncuesta?

  @@index([socioId])
  @@index([fechaVisita])
}

model ItemPlatoConsumido {
  id              String        @id @default(uuid())
  visitaConsumoId String
  visitaConsumo   VisitaConsumo @relation(fields: [visitaConsumoId], references: [id], onDelete: Cascade)
  nombrePlato     String
  cantidad        Int           @default(1)
  notas           String?

  @@index([visitaConsumoId])
}

model TicketAdjunto {
  id                 String        @id @default(uuid())
  visitaConsumoId    String        @unique
  visitaConsumo      VisitaConsumo @relation(fields: [visitaConsumoId], references: [id], onDelete: Cascade)
  urlArchivo         String?
  numeroTicketFiscal String?
  createdAt          DateTime      @default(now())
}

model TransaccionPuntos {
  id              String          @id @default(uuid())
  socioId         String
  socio           Socio           @relation(fields: [socioId], references: [id], onDelete: Cascade)
  registradoPorId String?
  registradoPor   Usuario?        @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  tipo            TipoTransaccion
  puntos          Int
  motivo          String
  createdAt       DateTime        @default(now())

  @@index([socioId])
  @@index([createdAt])
}

model Premio {
  id               String        @id @default(uuid())
  titulo           String
  descripcion      String
  puntosRequeridos Int
  imagenUrl        String?
  stock            Int           @default(-1) // -1 = ilimitado
  activo           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  canjes           CanjePremio[]
}

model CanjePremio {
  id              String       @id @default(uuid())
  socioId         String
  socio           Socio        @relation(fields: [socioId], references: [id], onDelete: Cascade)
  premioId        String
  premio          Premio       @relation(fields: [premioId], references: [id], onDelete: Restrict)
  validadoPorId   String?
  validadoPor     Usuario?     @relation(fields: [validadoPorId], references: [id], onDelete: SetNull)
  codigoQR        String       @unique
  estado          EstadoCanje  @default(PENDIENTE)
  puntosGastados  Int
  fechaExpiracion DateTime
  fechaCanje      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([codigoQR])
  @@index([socioId])
  @@index([estado])
}

model ConfiguracionPuntos {
  id                    String   @id @default(uuid())
  pesosPorPunto         Decimal  @default(1000.00) @db.Decimal(10, 2)
  puntosPorEncuesta     Int      @default(10)
  puntosPorReferido     Int      @default(5)
  minutosValidezQRCanje Int      @default(15)
  encuestaActiva        Boolean  @default(true) // Mostrar u ocultar las encuestas
  encuestaUnaVezPorSocio Boolean @default(false) // true = solo 1 vez por socio en total, false = 1 vez por cada visita
  updatedAt             DateTime @updatedAt
}

model PreguntaEncuesta {
  id        String   @id @default(uuid())
  texto     String
  categoria String?
  activa    Boolean  @default(true)
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  respuestas ItemRespuestaEncuesta[]
}

model RespuestaEncuesta {
  id              String                  @id @default(uuid())
  visitaConsumoId String                  @unique
  visitaConsumo   VisitaConsumo           @relation(fields: [visitaConsumoId], references: [id], onDelete: Cascade)
  socioId         String
  socio           Socio                   @relation(fields: [socioId], references: [id], onDelete: Cascade)
  puntosOtorgados Int                     @default(10)
  comentarios     String?
  createdAt       DateTime                @default(now())

  items           ItemRespuestaEncuesta[]

  @@index([socioId])
}

model ItemRespuestaEncuesta {
  id                  String            @id @default(uuid())
  respuestaEncuestaId String
  respuestaEncuesta   RespuestaEncuesta @relation(fields: [respuestaEncuestaId], references: [id], onDelete: Cascade)
  preguntaId          String
  pregunta            PreguntaEncuesta  @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  puntuacion          Int               @default(5)

  @@index([respuestaEncuestaId])
  @@index([preguntaId])
}

